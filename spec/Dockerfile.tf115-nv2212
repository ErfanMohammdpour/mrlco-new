# Phase 4 GPU runtime for Ada (RTX 4090 / sm_89).
# Official tensorflow/tensorflow:1.15.5-gpu-py3 is CUDA 10 and cannot GEMM on 4090.
# This image uses NVIDIA's public TF 1.15.5+nv22.12 wheel (CUDA 11.8, tf.contrib intact).
# No NGC login. Wheel: https://pypi.nvidia.com/nvidia-tensorflow/
#
#   docker build -f spec/Dockerfile.tf115-nv2212 -t margo-phase4-tf115-nv2212 spec
#   docker run --rm --gpus all -e MARGO_ALLOW_GPU=1 \
#     -v "$PWD":/work -w /work margo-phase4-tf115-nv2212 \
#     python spec/phase4_campaign.py --gpu-smoke --seed 0 --i-allow-gpu
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV TF_FORCE_GPU_ALLOW_GROWTH=true
ENV TF_CPP_MIN_LOG_LEVEL=2
ENV NVIDIA_TF_WHEEL=nvidia_tensorflow-1.15.5+nv22.12-6638418-cp38-cp38-linux_x86_64.whl

# Host CUDA apt mirrors 403 on some networks; CUDA runtime is already in the image.
RUN rm -f /etc/apt/sources.list.d/cuda*.list \
          /etc/apt/sources.list.d/nvidia*.list \
          /etc/apt/sources.list.d/*cuda* \
          /etc/apt/sources.list.d/*nvidia* \
 && apt-get update && apt-get install -y --no-install-recommends \
      python3 \
      python3-pip \
      python3-venv \
      curl \
      ca-certificates \
      git \
      graphviz \
      libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/python3 /usr/bin/python

RUN python3 -m pip install --no-cache-dir --upgrade "pip<24" "setuptools<60" "wheel==0.37.1" \
 && python3 -m pip install --no-cache-dir \
      "numpy==1.21.6" \
      "protobuf==3.19.6" \
      "absl-py==0.15.0" \
      "wrapt==1.12.1" \
      "gast==0.2.2" \
      "astor==0.8.1" \
      "termcolor==1.1.0" \
      "keras-preprocessing==1.1.2" \
      "google-pasta==0.2.0" \
      "opt-einsum==3.3.0" \
      "grpcio==1.41.1" \
      "astunparse==1.6.3" \
      "six==1.16.0" \
      "h5py==2.10.0" \
      "keras-applications==1.0.8" \
      "werkzeug==1.0.1" \
      "markdown==3.3.7" \
      "PyYAML==5.4.1" \
      "pydotplus==2.0.2" \
      "pyparsing==2.4.7" \
      "joblib==0.17.0" \
      "scipy==1.5.4" \
      "pyprind==2.11.3" \
      "cloudpickle==1.2.2" \
      "pyglet==1.5.0" \
      "gym==0.15.7" \
      "tensorflow-estimator==1.15.1" \
 && curl -fL --retry 3 \
      -o /tmp/${NVIDIA_TF_WHEEL} \
      "https://pypi.nvidia.com/nvidia-tensorflow/nvidia_tensorflow-1.15.5%2Bnv22.12-6638418-cp38-cp38-linux_x86_64.whl" \
 && python3 -m pip install --no-cache-dir --no-deps "/tmp/${NVIDIA_TF_WHEEL}" \
 && rm -f "/tmp/${NVIDIA_TF_WHEEL}"

WORKDIR /work
